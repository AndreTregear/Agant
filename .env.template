# ╔══════════════════════════════════════════════════════════════════╗
# ║  Oficina Digital — Environment Configuration                    ║
# ║  Copy to .env and fill in values, or run scripts/setup.sh       ║
# ╚══════════════════════════════════════════════════════════════════╝

# ──────────────────────────────────────────────
# General
# ──────────────────────────────────────────────
DOMAIN=oficina.local
COMPANY_NAME=Mi Empresa
ADMIN_EMAIL=admin@oficina.local
TIMEZONE=America/Lima
LOCALE=es_PE

# Data directory (persistent volumes)
DATA_DIR=./data

# Enabled profiles (comma-separated)
# All: foundation,identity,proxy,erp,nextcloud,mail,chat,wordpress,analytics,helpdesk,automation,ai,rag,agent,management
ENABLED_PROFILES=foundation,identity,proxy,erp,nextcloud,mail,chat,wordpress,analytics,helpdesk,automation,ai,rag,agent,management

# ──────────────────────────────────────────────
# PostgreSQL (used by: Nextcloud, Superset, n8n, Zammad, Authentik, agente-ceo)
# ──────────────────────────────────────────────
POSTGRES_USER=oficina
POSTGRES_PASSWORD=CHANGE_ME_postgres

# ──────────────────────────────────────────────
# MariaDB (used by: ERPNext, WordPress)
# ──────────────────────────────────────────────
MARIADB_ROOT_PASSWORD=CHANGE_ME_mariadb
# Least-privilege user for WordPress; scoped to the wordpress DB only.
WORDPRESS_DB_PASSWORD=CHANGE_ME_wordpress_db
# Read-only user used by Superset to query MariaDB (SELECT on *.*).
SUPERSET_READ_PASSWORD=CHANGE_ME_superset_read

# ──────────────────────────────────────────────
# Redis (shared cache/queue)
# ──────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis

# ──────────────────────────────────────────────
# MongoDB (used by: Rocket.Chat)
# ──────────────────────────────────────────────
MONGO_USER=oficina
MONGO_PASSWORD=CHANGE_ME_mongo

# ──────────────────────────────────────────────
# Elasticsearch (used by: RAGFlow, Zammad)
# ──────────────────────────────────────────────
ELASTIC_PASSWORD=CHANGE_ME_elastic

# ──────────────────────────────────────────────
# Authentik (SSO)
# ──────────────────────────────────────────────
AUTHENTIK_SECRET_KEY=CHANGE_ME_authentik_secret

# ──────────────────────────────────────────────
# Nextcloud
# ──────────────────────────────────────────────
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME_nextcloud

# ──────────────────────────────────────────────
# Collabora Online (office suite)
# ──────────────────────────────────────────────
COLLABORA_ADMIN_USER=admin
COLLABORA_ADMIN_PASSWORD=CHANGE_ME_collabora

# ──────────────────────────────────────────────
# Stalwart Mail
# ──────────────────────────────────────────────
STALWART_ADMIN_USER=admin
STALWART_ADMIN_PASSWORD=CHANGE_ME_stalwart

# ──────────────────────────────────────────────
# WordPress + WooCommerce
# ──────────────────────────────────────────────
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=CHANGE_ME_wordpress

# WooCommerce REST API keys (generated after WooCommerce setup)
WOOCOMMERCE_KEY=
WOOCOMMERCE_SECRET=

# ──────────────────────────────────────────────
# Apache Superset (BI)
# ──────────────────────────────────────────────
SUPERSET_SECRET_KEY=CHANGE_ME_superset_secret
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=CHANGE_ME_superset

# ──────────────────────────────────────────────
# n8n (Automation)
# ──────────────────────────────────────────────
N8N_ENCRYPTION_KEY=CHANGE_ME_n8n_encryption
N8N_API_KEY=
# Shared-secret header validated by every webhook node in n8n workflows.
# Callers (Jibri, curl, external apps) must send X-Webhook-Token: <this>.
N8N_WEBHOOK_TOKEN=CHANGE_ME_n8n_webhook_token

# ──────────────────────────────────────────────
# ERPNext
# ──────────────────────────────────────────────
ERPNEXT_SITE=erp.oficina.local
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# ──────────────────────────────────────────────
# Rocket.Chat
# ──────────────────────────────────────────────
ROCKETCHAT_AUTH_TOKEN=
ROCKETCHAT_USER_ID=

# ──────────────────────────────────────────────
# Zammad
# ──────────────────────────────────────────────
ZAMMAD_TOKEN=

# ──────────────────────────────────────────────
# RAGFlow
# ──────────────────────────────────────────────
RAGFLOW_API_KEY=

# ──────────────────────────────────────────────
# agente-ceo (AI Agent Portal)
# Authentik OIDC credentials (generated during Authentik setup)
# ──────────────────────────────────────────────
AGENTE_CEO_OIDC_CLIENT_ID=CHANGE_ME_oidc_client_id
AGENTE_CEO_OIDC_CLIENT_SECRET=CHANGE_ME_oidc_client_secret

# ──────────────────────────────────────────────
# AI / LLM
# ──────────────────────────────────────────────
VLLM_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ
VLLM_QUANTIZATION=awq
VLLM_MAX_MODEL_LEN=8192
# 1 = air-gapped (models must be pre-downloaded). Set to 0 only for the
# initial one-time download on a network-connected bootstrap machine.
HF_HUB_OFFLINE=1

# ──────────────────────────────────────────────
# OIDC Secrets (per-service, auto-generated by post-install.sh)
# ──────────────────────────────────────────────
ERPNEXT_OIDC_SECRET=
NEXTCLOUD_OIDC_SECRET=
ROCKETCHAT_OIDC_SECRET=
STALWART_OIDC_SECRET=CHANGE_ME_stalwart_oidc
STALWART_OIDC_CLIENT_ID=stalwart-client
WORDPRESS_OIDC_SECRET=
SUPERSET_OIDC_SECRET=
SUPERSET_OIDC_CLIENT_ID=superset-client
SUPERSET_OIDC_CLIENT_SECRET=
ZAMMAD_OIDC_SECRET=
N8N_OIDC_SECRET=
PORTAINER_OIDC_SECRET=

# Rocket.Chat admin (first-boot)
ROCKETCHAT_ADMIN_USER=admin
ROCKETCHAT_ADMIN_PASSWORD=CHANGE_ME_rocketchat

# Zammad admin
ZAMMAD_ADMIN_PASSWORD=CHANGE_ME_zammad

# ERPNext admin
ERPNEXT_ADMIN_PASSWORD=CHANGE_ME_erpnext_admin

# ──────────────────────────────────────────────
# Portainer admin password (bcrypt hash)
# Generate with: htpasswd -nbB admin "your_password" | cut -d: -f2
# ──────────────────────────────────────────────
PORTAINER_ADMIN_PASSWORD=

# ──────────────────────────────────────────────
# Jitsi Meet internal XMPP auth (Jibri/Jicofo/JVB — not end-user creds)
# ──────────────────────────────────────────────
JIBRI_XMPP_PASSWORD=CHANGE_ME_jibri_xmpp
JIBRI_RECORDER_PASSWORD=CHANGE_ME_jibri_recorder
JICOFO_AUTH_PASSWORD=CHANGE_ME_jicofo_auth
JVB_AUTH_PASSWORD=CHANGE_ME_jvb_auth
# Credentials Jibri uses to upload finished recordings to Nextcloud.
# Create a dedicated least-privilege Nextcloud user for this.
JIBRI_NEXTCLOUD_USER=jibri
JIBRI_NEXTCLOUD_PASS=CHANGE_ME_jibri_nextcloud
